    "html": "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns:d=\"http://www.apple.com/DTDs/DictionaryService-1.0.rng\"><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" /></head><body><d:entry id=\"s_b-es-en0043726\" d:title=\"solo\" class=\"entry\"><span class=\"hwg x_xh0\"><span d:dhw=\"1\" role=\"text\" frequent=\"y\" hm=\"3\" class=\"hw\">solo<span class=\"gp ty_hom tg_hw\"> 3 </span></span></span><span id=\"s_b-es-en0043726.001\" class=\"gramb x_xd0\"><span d:pos=\"1\" class=\"ps x_xdh\">masculine noun <d:pos></d:pos></span><span id=\"s_b-es-en0043726.002\" class=\"semb x_xd1 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">1 </span><span class=\"trg x_xd2\"><span class=\"lg\"><span class=\"gp tg_lg\">(</span><span class=\"fld\">Music</span><span class=\"gp tg_lg\">) </span></span><span d:def=\"1\" class=\"trans\">solo <d:def></d:def></span></span><span class=\"exg x_xd2 hasSn\"><span class=\"x_xdh\"><span class=\"sn\">▸ </span><span class=\"ex\">un <span class=\"rf\">solo</span> de violín </span></span><span class=\"trg x_xd3\"><span class=\"trans\">a violin solo </span></span></span></span><span id=\"s_b-es-en0043726.003\" class=\"semb x_xd1 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">2 </span><span class=\"trg x_xd2\"><span class=\"lg\"><span class=\"gp tg_lg\">(</span><span class=\"reg\">Spain</span><span class=\"gp tg_lg\">) </span></span><span class=\"ind\"><span class=\"gp tg_ind\">(</span>café<span class=\"gp tg_ind\">) </span></span><span d:def=\"1\" class=\"trans\">black coffee <d:def></d:def></span></span></span></span></d:entry></body></html>\n",
