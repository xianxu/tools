    "html": "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns:d=\"http://www.apple.com/DTDs/DictionaryService-1.0.rng\"><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" /></head><body><d:entry id=\"s_b-es-en0040093\" d:title=\"red\" class=\"entry\"><span class=\"hwg x_xh0\"><span d:dhw=\"1\" role=\"text\" frequent=\"y\" class=\"hw\">red </span></span><span id=\"s_b-es-en0040093.001\" class=\"gramb x_xd0\"><span d:pos=\"1\" class=\"ps x_xdh\">feminine noun <d:pos></d:pos></span><span id=\"s_b-es-en0040093.002\" class=\"semb x_xd1 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">1 </span><span id=\"s_b-es-en0040093.003\" class=\"semb x_xd2 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">a </span><span class=\"trg x_xd3\"><span class=\"ind\"><span class=\"gp tg_ind\">(</span>para pescar<span class=\"gp tg_ind\">) </span></span><span d:def=\"1\" class=\"trans\">net <d:def></d:def></span></span></span><span id=\"s_b-es-en0040093.004\" class=\"semb x_xd2 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">b </span><span class=\"trg x_xd3\"><span class=\"lg\"><span class=\"gp tg_lg\">(</span><span class=\"fld\">Sport</span><span class=\"gp tg_lg\">) </span></span><span class=\"trans\">net </span></span><span class=\"exg x_xd3 hasSn\"><span class=\"x_xdh\"><span class=\"sn\">▸ </span><span class=\"ex\">subir a la <span class=\"rf\">red </span></span></span><span class=\"trg x_xd4\"><span class=\"trans\">to go up to <span class=\"underline\">or</span> go into the net </span></span></span></span><span id=\"s_b-es-en0040093.005\" class=\"semb x_xd2 hasSn\"><span class=\"gp x_xdh sn ty_label tg_semb\">c </span><span class=\"trg x_xd3\"><span class=\"ind\"><span class=\"gp tg_ind\">(</span>para el pelo<span class=\"gp tg_ind\">) </span></span><span class=\"trans\">hairnet </span></span></spa